# ============================================================
# FlowLead CRM — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores
# ============================================================

# ── Banco de Dados ───────────────────────────────────────────
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:senha@localhost:5432/flowlead_crm"

# ── NextAuth ─────────────────────────────────────────────────
# Gere uma secret forte: openssl rand -base64 32
NEXTAUTH_SECRET="sua-secret-aqui"
NEXTAUTH_URL="http://localhost:3000"

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="FlowLead CRM"

# ── WhatsApp (Evolution API ou Z-API) ────────────────────────
# WHATSAPP_API_URL=""
# WHATSAPP_API_TOKEN=""
# WHATSAPP_INSTANCE=""

# ── E-mail (Resend / SMTP) ───────────────────────────────────
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@flowlead.com.br"

# ── Uploads ──────────────────────────────────────────────────
# STORAGE_PROVIDER="local"   # local | s3
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""
# AWS_REGION=""
